# =====================================================================
# Copy this file to `.env` and fill in values for your Azure ML workspace.
# `.env` is gitignored — never commit it.
# =====================================================================

# --- Azure subscription / workspace targeting -----------------------
# Find these in the Azure Portal on your Azure ML workspace overview,
# or run: az ml workspace show --name <ws> --resource-group <rg>
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=my-ml-rg
AZURE_ML_WORKSPACE=my-ml-workspace

# --- Inputs for the batch invoke ------------------------------------
# Reference a data asset already registered in the workspace.
# Format: azureml:<asset-name>:<version>
# Register one via:
#   az ml data create --name customer_batch_input --version 1 \
#                     --type uri_file --path ./input/data.csv \
#                     --resource-group <rg> --workspace-name <ws>
INPUT_DATA_ASSET=azureml:customer_batch_input:1

# Type of the input data asset. Must match the asset's registered type.
# One of: uri_file, uri_folder, mltable
INPUT_TYPE=uri_file

# --- Source YAML definitions ----------------------------------------
# Paths (relative to the script working dir) to the endpoint/deployment
# YAML files. Copy the *.template files in this repo and customize them.
BATCH_ENDPOINT_YAML=batch-endpoint.yml
BATCH_DEPLOYMENT_YAML=batch-deployment.yml

# --- Endpoint naming ------------------------------------------------
# Prefix used to auto-generate a unique endpoint name on every run.
# Rules: lowercase alphanumeric + hyphens, start with a letter, and
# leave room for an 8-char hex suffix (final name <= 32 chars).
BATCH_ENDPOINT_PREFIX=hello-batch

# --- Cleanup behavior -----------------------------------------------
# When true, invoke_batch_endpoint.py deletes the endpoint it created
# (and its deployments) once the job reaches a terminal state.
# Set to false to keep the endpoint around for debugging.
DELETE_ENDPOINT_AFTER_INVOKE=true
